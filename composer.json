{
  "name": "milpa/command",
  "description": "The Command-as-atom core: the surface-agnostic Operation value object plus the CommandProvider and SurfaceProjector contracts. One operation, N surfaces.",
  "keywords": [
    "php",
    "milpa",
    "framework",
    "command-pattern",
    "cqrs",
    "value-object",
    "surface-agnostic"
  ],
  "type": "milpa-capability",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Rodrigo Vicente - TeamX Agency",
      "homepage": "https://x.com/rodrigoteamx"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-sodium": "*",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpdoc-parser": "^2.3",
    "friendsofphp/php-cs-fixer": "^3.65",
    "milpa/core": "*"
  },
  "autoload": {
    "psr-4": {
      "Milpa\\Command\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Milpa\\Command\\Tests\\": "tests/",
      "Milpa\\Docs\\": "vendor/milpa/core/tools/gen-docs/"
    }
  },
  "extra": {
    "milpa": {
      "capability": {
        "id": "command",
        "title": "One operation, every surface: CLI, MCP and HTTP from a single declaration",
        "unlocks": [
          "coa <operaci\u00f3n>"
        ],
        "provides": [
          "command.operations",
          "command.projector"
        ],
        "briefing": "This app declares operations once and they reach every surface.",
        "contracts": {
          "command.operations": "Milpa\\Command\\Operation",
          "command.projector": "Milpa\\Command\\CommandProvider"
        }
      }
    }
  }
}
